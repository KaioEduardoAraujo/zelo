# Copie para .env.local e preencha. NUNCA comite o .env.local.
# Em produção, configure as mesmas variáveis no painel da Vercel.

# --- Públicas (vão para o navegador; nada secreto aqui) ---
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...) ou anon (legada). Limitada pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL base usada para montar o link da proposta. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Segredos do servidor (sem NEXT_PUBLIC_, nunca no navegador) ---
# Chave service_role ou secret key (sb_secret_...). Ignora o RLS: só no servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo do HMAC dos hashes de OTP e token. Gere com: openssl rand -base64 48
HASH_PEPPER=

# --- E-mail ---
# resend | smtp
EMAIL_PROVIDER=resend
# Ex.: "Zelo <onboarding@resend.dev>" (sem domínio próprio) ou "Zelo <seu@gmail.com>" (SMTP)
EMAIL_FROM=
RESEND_API_KEY=
# SMTP (Gmail: smtp.gmail.com, 465, seu e-mail e uma "senha de app" de 16 caracteres)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Seed do administrador (usado só pelo script de seed, Fase 1) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
